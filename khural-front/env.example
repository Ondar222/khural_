## Frontend environment variables (Vite)
##
## По умолчанию фронт использует same-origin "/api".
## В dev Vite проксирует /api → https://khural.yurta.site (см. vite.config.js).
## Локальный бэкенд: VITE_API_PROXY_TARGET=http://localhost:3004

# Обычно оставляют пустым (same-origin /api).
# VITE_API_BASE_URL=/api
VITE_API_BASE_URL=

# Куда проксировать /api в `npm run dev` (по умолчанию прод):
# VITE_API_PROXY_TARGET=https://khural.yurta.site
# VITE_API_PROXY_TARGET=http://localhost:3004

# Optional: storage keys (defaults: access_token / refresh_token; legacy auth_token is also supported)
# VITE_API_TOKEN_STORAGE_KEY=access_token
# VITE_API_REFRESH_TOKEN_STORAGE_KEY=refresh_token
